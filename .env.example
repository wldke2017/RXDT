PORT=5000
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require

# REQUIRED — used to sign/verify JWT auth tokens. Must be a long random string.
# In production, generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here

# REQUIRED for admin dashboard access — set a strong unique value.
# The admin dashboard lock screen now asks for this secret at login.
ADMIN_SECRET=your_admin_secret_here

# Optional — for sending verification / password-reset emails via Resend.
RESEND_API_KEY=re_your_resend_api_key_here

# Optional — admin notification email. When set, the server emails this
# address whenever a new pending deposit, withdrawal, or KYC submission
# arrives so the admin is alerted even when the dashboard is closed.
ADMIN_NOTIFY_EMAIL=admin@yourdomain.com
